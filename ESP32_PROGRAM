#include <WiFi.h>
#include <ESP32Servo.h> 

// WiFi 
const char* ssid = "Arjun_Dahal";
const char* password = "CLEB2D6D4F";
WiFiServer server(80);

// Motor Pins
#define ENA_PIN 25
#define IN1_PIN 26
#define IN2_PIN 27
#define ENB_PIN 14
#define IN3_PIN 12
#define IN4_PIN 13

// Ultrasonic 
#define TRIG_PIN 32
#define ECHO_PIN 33

// Servo 
#define SERVO_PIN 23
Servo servoSensor;

// Motor Struct
struct motor {
  byte speed = 0;
  struct { byte input1 = LOW; byte input2 = LOW; } direction;
};
motor motorA, motorB;

// Self-driving flag 
bool selfDriving = false;

// PWM Channels 
#define CHANNEL_A 0
#define CHANNEL_B 1

void setupPWM()
{
  ledcAttachPin(ENA_PIN, CHANNEL_A);
  ledcAttachPin(ENB_PIN, CHANNEL_B);
  ledcSetup(CHANNEL_A, 1000, 8);     // 1 kHz, 8-bit
  ledcSetup(CHANNEL_B, 1000, 8);
}

// Motor Functions
void sendToMotor(motor &m, int channel, int in1, int in2)
{
  ledcWrite(channel, m.speed);
  digitalWrite(in1, m.direction.input1);
  digitalWrite(in2, m.direction.input2);
}

void sendToMotorA()
{
  sendToMotor(motorA, CHANNEL_A, IN1_PIN, IN2_PIN);
}

void sendToMotorB()
{
  sendToMotor(motorB, CHANNEL_B, IN3_PIN, IN4_PIN);
}

void setMotorSpeed(motor &m, byte spd)
{
  m.speed = spd;
}

void setMotorDirectionForward(motor &m)
{
  m.direction.input1 = HIGH;
  m.direction.input2 = LOW;
}

void setMotorDirectionBackward(motor &m)
{
  m.direction.input1 = LOW;
  m.direction.input2 = HIGH;
}

void stopMotor(motor &m)
{
  m.speed = 0;
  m.direction.input1 = LOW;
  m.direction.input2 = LOW;
}

void motorStop()
{
  stopMotor(motorA);
  stopMotor(motorB);
  sendToMotorA();
  sendToMotorB();
}

void speedUp()
{
  if (motorA.speed < 255) motorA.speed += 20;
  if (motorB.speed < 255) motorB.speed += 20;
  sendToMotorA();
  sendToMotorB();
}

void speedDown()
{
  if (motorA.speed > 20) motorA.speed -= 20;
  if (motorB.speed > 20) motorB.speed -= 20;
  sendToMotorA();
  sendToMotorB();
}

void goForward()
{
  setMotorDirectionForward(motorA);
  setMotorDirectionForward(motorB);
  sendToMotorA();
  sendToMotorB();
}

void goBackward()
{
  setMotorDirectionBackward(motorA);
  setMotorDirectionBackward(motorB);
  sendToMotorA();
  sendToMotorB();
}

void turnLeft()
{
  setMotorDirectionForward(motorA);
  setMotorDirectionBackward(motorB);
  sendToMotorA();
  sendToMotorB();
}

void turnRight()
{
  setMotorDirectionBackward(motorA);
  setMotorDirectionForward(motorB);
  sendToMotorA();
  sendToMotorB();
}

// Ultrasonic
long readDistanceCM()
{
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  long distance = duration * 0.034 / 2;

  return distance;
}

// Self-driving
void selfDrivingLoop()
{
  if (!selfDriving) return;

  long centerDist = readDistanceCM();

  if (centerDist > 10) {
    goForward();
  }
  else {
    motorStop();
    delay(200);

    long distances[3];
    int direction = -1;

    // Scan Left
    servoSensor.write(0);
    delay(500);
    distances[0] = readDistanceCM();

    // Scan Center
    servoSensor.write(90);
    delay(500);
    distances[1] = readDistanceCM();

    // Scan Right
    servoSensor.write(180);
    delay(500);
    distances[2] = readDistanceCM();

    long maxDist = distances[0];
    direction = 0;

    for (int i = 1; i < 3; i++) {
      if (distances[i] > maxDist) {
        maxDist = distances[i];
        direction = i;
      }
    }

    if (maxDist > 10) {
      if (direction == 0) turnLeft();
      else if (direction == 1) goForward();
      else turnRight();
    }
    else {
      motorStop();
    }
  }
}

